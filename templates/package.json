{
  "name": "func-template",
  "version": "1.1.5",
  "main": "dist/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "funcgo dev --",
    "build": "funcgo build",
    "test": "vitest run",
    "test:cli": "pnpm build && vitest run --config vitest.cli.config.mts",
    "format": "prettier --write .",
    "prettier": "prettier --write . --ignore-path ../.prettierignore"
  },
  "files": [
    "src",
    "tests",
    "README.md",
    "tsconfig.json",
    "vitest.config.mts",
    "vitest.cli.config.mts",
    ".gitignore"
  ],
  "func": {
    "entry": "src/index.ts",
    "outDir": "dist"
  },
  "prettier": "@unix/prettier",
  "bin": {
    "template": "./dist/bin.js"
  },
  "dependencies": {
    "func": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@unix/prettier": "^0.1.0",
    "funcgo": "latest",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
