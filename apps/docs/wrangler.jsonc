{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "func-docs",
  "compatibility_date": "2026-06-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
