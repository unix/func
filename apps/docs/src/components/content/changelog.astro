---
import { defaultLocale, type Locale } from '@/lib/docs'

interface Props {
  locale?: Locale
}

const { locale = defaultLocale } = Astro.props
const seriesLabel = locale === 'zh-cn' ? '系列' : 'series'
const legacySummary =
  locale === 'zh-cn'
    ? 'func 1.0.0 发布于 2019-06-13，奠定了框架的基础能力：使用装饰器定义命令，并提供选项解析、命令分发、元数据注册和服务注入。'
    : 'func 1.0.0 was released on 2019-06-13 and established the framework’s foundations: decorator-based command definitions, option parsing, command dispatch, metadata registration, and service injection.'
---

<div class="changelog">
  <section class="changelog-section" aria-labelledby="series-2">
    <h2 class="changelog-series-title" id="series-2">
      2.x {seriesLabel}
    </h2>

    <div class="changelog-list" data-minimap-ignore><slot /></div>
  </section>

  <section class="changelog-section" aria-labelledby="series-1">
    <h2 class="changelog-series-title" id="series-1">
      1.x {seriesLabel}
    </h2>
    <div class="changelog-legacy">
      <span class="changelog-marker" aria-hidden="true"></span>
      <p>{legacySummary}</p>
    </div>
  </section>
</div>
