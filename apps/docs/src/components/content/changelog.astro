---
import { defaultLocale, type Locale } from '@/lib/docs'

interface Props {
  locale?: Locale
}

const { locale = defaultLocale } = Astro.props
const legacyTitle = locale === 'zh-cn' ? 'v1 版本' : 'v1'
const legacySummary =
  locale === 'zh-cn'
    ? 'func 1.0.0 发布于 2019-06-13，奠定了框架的基础能力：使用装饰器定义命令，并提供选项解析、命令分发、元数据注册和服务注入。'
    : 'func 1.0.0 was released on 2019-06-13 and established the framework’s foundations: decorator-based command definitions, option parsing, command dispatch, metadata registration, and service injection.'
---

<div class="changelog">
  <slot />

  <section class="changelog-section" aria-labelledby="version-1">
    <h2 class="changelog-series-title" id="version-1">{legacyTitle}</h2>
    <div class="changelog-legacy">
      <span class="changelog-marker" aria-hidden="true"></span>
      <p>{legacySummary}</p>
    </div>
  </section>
</div>
