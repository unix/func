---
import type { SystemErrorFrontmatter } from '@/lib/system-errors'
import { defaultLocale, type Locale } from '@/lib/docs'
import DocsLayout from '@/layouts/docs.astro'

interface Props {
  frontmatter: SystemErrorFrontmatter
  locale?: Locale
}

const { frontmatter, locale = defaultLocale } = Astro.props
const { code } = frontmatter
const localePath = locale === defaultLocale ? '' : `${locale}/`
const markdownPath = `/${localePath}errors/${code}.md`
const editUrl = `https://github.com/unix/func/edit/main/apps/docs/src/content/errors/${localePath}${code}.mdx`
const errorIndexPath = locale === defaultLocale ? '/errors' : `/${locale}/errors`
const errorIndexLabel = locale === 'zh-cn' ? '← 错误索引' : '← Errors'
const languageSwitchHref =
  locale === defaultLocale ? `/zh-cn/errors/${code}` : `/errors/${code}`
---

<DocsLayout
  editUrl={editUrl}
  frontmatter={frontmatter}
  languageSwitchHref={languageSwitchHref}
  locale={locale}
  markdownPath={markdownPath}
  page="errors">
  <Fragment slot="title-prefix">
    <a
      class="mb-5 inline-flex rounded-sm font-mono text-xs text-muted-foreground outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring"
      href={errorIndexPath}>
      {errorIndexLabel}
    </a>
    <p class="mb-3 font-mono text-xs text-violet-700 dark:text-violet-300">
      {code}
    </p>
  </Fragment>

  <slot />
</DocsLayout>
