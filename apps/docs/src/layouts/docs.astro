---
import DocsHeader from '@/components/layouts/docs-header.astro'
import DocsFooter from '@/components/layouts/docs-footer.astro'
import DocsMinimap from '@/components/layouts/docs-minimap.astro'
import DocsSidebar from '@/components/layouts/docs-sidebar.astro'
import DocsTitleMeta from '@/components/layouts/docs-title-meta.astro'
import DocsToolbar from '@/components/layouts/docs-toolbar.astro'
import {
  defaultLocale,
  getEditUrl,
  getMarkdownPath,
  type DocFrontmatter,
  type DocPage,
  type Locale,
} from '@/lib/docs'
import Layout from '@/layouts/main.astro'

interface Props {
  editUrl?: string
  frontmatter: DocFrontmatter
  languageSwitchHref?: string
  locale?: Locale
  markdownPath?: string
  page: DocPage
}

const {
  editUrl: editUrlOverride,
  frontmatter,
  languageSwitchHref,
  locale = defaultLocale,
  markdownPath: markdownPathOverride,
  page,
} = Astro.props
const { description, lastModified, title } = frontmatter
const markdownPath = markdownPathOverride ?? getMarkdownPath(page, locale)
const editUrl = editUrlOverride ?? getEditUrl(page, locale)
---

<Layout
  title={title}
  description={description}
  lastModified={lastModified}
  locale={locale}>
  <DocsHeader
    languageSwitchHref={languageSwitchHref}
    locale={locale}
    page={page}
  />

  <main
    class="mx-auto grid min-h-[calc(100svh-4rem)] w-full max-w-[90rem] min-w-0 bg-background px-4 sm:px-6 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-8 lg:px-8 xl:grid-cols-[11rem_minmax(0,1fr)_11rem] xl:gap-x-10">
    <DocsSidebar locale={locale} page={page} />

    <div
      class="mx-auto min-w-0 w-full max-w-3xl pt-6 pb-8 md:pt-8 md:pb-12 lg:pt-10 lg:pb-16">
      <div class="mb-10">
        <slot name="title-prefix" />
        <h1 class="docs-title">{title}</h1>
        <div class="docs-description">
          <p>{description}</p>
        </div>
        <div
          class="mt-5 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
          <DocsTitleMeta lastModified={lastModified} locale={locale} />
          <DocsToolbar locale={locale} markdownPath={markdownPath} />
        </div>
      </div>

      <article
        class="prose-static min-w-0"
        data-doc-content
        data-doc-page={page}>
        <slot />
      </article>

      <DocsFooter editUrl={editUrl} locale={locale} />
    </div>

    <DocsMinimap locale={locale} />
  </main>
</Layout>
