{
  "name": "func-cli-benchmarks",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "benchmark-cac": "./dist/cac/bin.mjs",
    "benchmark-commander": "./dist/commander/bin.mjs",
    "benchmark-func": "./dist/func/bin.js",
    "benchmark-func-parser": "./dist/func-parser/bin.mjs",
    "benchmark-oclif": "./dist/oclif/bin.mjs",
    "benchmark-yargs": "./dist/yargs/bin.mjs"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/bundle.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prettier": "prettier --write . --ignore-path ../.prettierignore",
    "report": "pnpm build && vitest run && node scripts/benchmark.mjs",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@oclif/core": "4.13.2",
    "cac": "7.0.0",
    "commander": "15.0.0",
    "func": "3.0.0-canary.2",
    "yargs": "18.1.0"
  },
  "prettier": "@unix/prettier",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/yargs": "17.0.35",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@unix/eslint": "^1.3.0",
    "@unix/prettier": "^0.1.0",
    "esbuild": "^0.27.7",
    "eslint": "^10.8.1",
    "funcgo": "1.2.0-canary.3",
    "globals": "^17.9.0",
    "prettier": "^3.8.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.7"
  },
  "oclif": {
    "bin": "benchmark-oclif",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/oclif/commands.mjs",
      "identifier": "COMMANDS"
    },
    "dirname": "benchmark-oclif",
    "topicSeparator": " "
  }
}
