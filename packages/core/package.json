{
  "name": "func",
  "version": "3.0.1",
  "type": "commonjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.mjs"
    },
    "./_internal/precompiled-v2": {
      "types": "./dist/types/subpath/precompiled/index.d.ts",
      "import": "./dist/precompiled.mjs",
      "require": "./dist/precompiled.mjs"
    },
    "./_internal/precompiler-v2": {
      "types": "./dist/types/subpath/precompiler/index.d.ts",
      "import": "./dist/precompiler.mjs",
      "require": "./dist/precompiler.mjs"
    },
    "./testing": {
      "types": "./dist/types/subpath/testing/index.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.mjs"
    },
    "./testing/cli": {
      "types": "./dist/types/subpath/testing/cli/index.d.ts",
      "import": "./dist/testing-cli.mjs",
      "require": "./dist/testing-cli.mjs"
    },
    "./testing/fixtures": {
      "types": "./dist/types/subpath/testing/fixtures/index.d.ts",
      "import": "./dist/testing-fixtures.mjs",
      "require": "./dist/testing-fixtures.mjs"
    },
    "./testing/pty": {
      "types": "./dist/types/subpath/testing/pty/index.d.ts",
      "import": "./dist/testing-pty.mjs",
      "require": "./dist/testing-pty.mjs"
    },
    "./invoke": {
      "types": "./dist/types/subpath/invoke/index.d.ts",
      "import": "./dist/invoke.mjs",
      "require": "./dist/invoke.mjs"
    },
    "./config": {
      "types": "./dist/types/subpath/config/index.d.ts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.mjs"
    },
    "./completion": {
      "types": "./dist/types/subpath/completion/index.d.ts",
      "import": "./dist/completion.mjs",
      "require": "./dist/completion.mjs"
    },
    "./log": {
      "types": "./dist/types/subpath/log/index.d.ts",
      "import": "./dist/log.mjs",
      "require": "./dist/log.mjs"
    },
    "./signals": {
      "types": "./dist/types/subpath/signals/index.d.ts",
      "import": "./dist/signals.mjs",
      "require": "./dist/signals.mjs"
    },
    "./help": {
      "types": "./dist/types/subpath/help/index.d.ts",
      "import": "./dist/help.mjs",
      "require": "./dist/help.mjs"
    },
    "./json-output": {
      "types": "./dist/types/subpath/json-output/index.d.ts",
      "import": "./dist/json-output.mjs",
      "require": "./dist/json-output.mjs"
    },
    "./http": {
      "types": "./dist/types/subpath/http/index.d.ts",
      "import": "./dist/http.mjs",
      "require": "./dist/http.mjs"
    },
    "./http/testing": {
      "types": "./dist/types/subpath/http/testing/index.d.ts",
      "import": "./dist/http-testing.mjs",
      "require": "./dist/http-testing.mjs"
    },
    "./net": {
      "types": "./dist/types/subpath/net/index.d.ts",
      "import": "./dist/net.mjs",
      "require": "./dist/net.mjs"
    },
    "./net/testing": {
      "types": "./dist/types/subpath/net/testing/index.d.ts",
      "import": "./dist/net-testing.mjs",
      "require": "./dist/net-testing.mjs"
    },
    "./parser": {
      "types": "./dist/types/subpath/parser/index.d.ts",
      "import": "./dist/parser.mjs",
      "require": "./dist/parser.cjs"
    },
    "./process": {
      "types": "./dist/types/subpath/process/index.d.ts",
      "import": "./dist/process.mjs",
      "require": "./dist/process.mjs"
    },
    "./process/testing": {
      "types": "./dist/types/subpath/process/testing/index.d.ts",
      "import": "./dist/process-testing.mjs",
      "require": "./dist/process-testing.mjs"
    }
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "pnpm build && tsc -p e2e/tsconfig.json && vitest run --config vitest.e2e.config.mts",
    "test:file": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "pnpm clean",
    "build": "pnpm test && pnpm build:types && pnpm build:js",
    "build:js": "rolldown -c rolldown.config.mjs",
    "build:types": "rolldown -c rolldown.dts.config.mjs",
    "lint": "eslint .",
    "prettier": "prettier --write . --ignore-path ../../.prettierignore",
    "release": "pnpm build && pnpm publish --access public --no-git-checks",
    "release:canary": "pnpm build && pnpm publish --access public --tag canary --no-git-checks"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "command",
    "cli-framework",
    "command-line-tool"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unix/func.git"
  },
  "prettier": "@unix/prettier",
  "devDependencies": {
    "@func/contracts": "workspace:*",
    "@swc/core": "^1.15.47",
    "@types/node": "^26.1.2",
    "@unix/eslint": "^1.3.0",
    "@unix/prettier": "^0.1.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "rolldown": "^1.2.3",
    "rolldown-plugin-dts": "^0.28.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.10",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  }
}
