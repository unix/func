{
  "name": "func",
  "version": "2.3.1",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "pnpm build && tsc -p e2e/tsconfig.json && vitest run --config vitest.e2e.config.mts",
    "test:file": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "pnpm clean",
    "build": "pnpm test && pnpm build:types && pnpm build:js",
    "build:js": "rolldown -c rolldown.config.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "prettier": "prettier --write . --ignore-path ../../.prettierignore",
    "release": "pnpm build && pnpm publish --access public --no-git-checks"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "command",
    "cli-framework",
    "command-line-tool"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unix/func.git"
  },
  "prettier": "@unix/prettier",
  "devDependencies": {
    "@func/shared": "workspace:*",
    "@swc/core": "^1.15.47",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^26.1.2",
    "@unix/eslint": "^1.3.0",
    "@unix/prettier": "^0.1.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "rolldown": "^1.2.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-swc": "^1.5.10",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "arg": "^5.0.2",
    "reflect-metadata": "^0.2.2"
  }
}
