{
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "removeComments": true,
    "declaration": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "isolatedModules": true
  },
  "files": [
    "src/index.ts",
    "src/subpath/completion/index.ts",
    "src/subpath/config/index.ts",
    "src/subpath/help/index.ts",
    "src/subpath/log/index.ts",
    "src/subpath/testing/index.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
