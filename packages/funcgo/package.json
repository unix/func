{
  "name": "funcgo",
  "version": "1.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "funcgo": "./dist/bin.js"
  },
  "scripts": {
    "prebuild": "pnpm clean",
    "build": "tsc && pnpm chmod-bin",
    "clean": "node -e \"require('fs').rmSync('dist', { force: true, recursive: true })\"",
    "chmod-bin": "node -e \"require('fs').chmodSync('dist/bin.js', 0o755)\"",
    "test": "vitest run",
    "test:manual:build": "cd manual-e2e/build && ts-node --project ../../tsconfig.json ../../src/bin.ts build",
    "test:manual:watch": "cd manual-e2e/watch-build && ts-node --project ../../tsconfig.json ../../src/bin.ts build --watch",
    "release": "pnpm build && pnpm publish --access public --no-git-checks",
    "format": "prettier --write ."
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unix/func.git",
    "directory": "packages/funcgo"
  },
  "prettier": "@unix/prettier",
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "@vercel/ncc": "^0.44.1",
    "arg": "^5.0.2",
    "picomatch": "^4.0.5",
    "rolldown": "^1.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.3",
    "@unix/prettier": "^0.1.0",
    "prettier": "^3.9.6",
    "unplugin-swc": "^1.5.10",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
