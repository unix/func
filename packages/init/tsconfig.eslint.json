{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "func": ["../core/src/index.ts"],
      "func/help": ["../core/src/subpath/help/index.ts"],
      "func/testing": ["../core/src/subpath/testing/index.ts"],
      "func/testing/cli": ["../core/src/subpath/testing/cli/index.ts"],
      "func/testing/fixtures": ["../core/src/subpath/testing/fixtures/index.ts"]
    },
    "rootDir": "..",
    "skipLibCheck": true
  },
  "files": [],
  "include": ["*.config.mts", "src/**/*.ts", "tests/**/*.ts"]
}
