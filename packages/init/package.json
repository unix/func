{
  "name": "create-func",
  "version": "1.0.1",
  "main": "dist/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "create-func": "./dist/bin.js"
  },
  "scripts": {
    "dev": "funcgo dev --",
    "build": "funcgo build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cli": "pnpm build && vitest run --config vitest.cli.config.mts",
    "release": "pnpm build && pnpm publish --access public --no-git-checks",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prettier": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unix/func.git",
    "directory": "packages/init"
  },
  "func": {
    "entry": "src/index.ts",
    "outDir": "dist"
  },
  "prettier": "@unix/prettier",
  "dependencies": {
    "func": "workspace:*",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@func/contracts": "workspace:*",
    "@types/node": "^26.1.2",
    "@unix/eslint": "^1.3.0",
    "@unix/prettier": "^0.1.0",
    "eslint": "^10.8.1",
    "funcgo": "workspace:*",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
