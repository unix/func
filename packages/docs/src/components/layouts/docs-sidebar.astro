---
import { defaultLocale, getNavGroups, type DocPage, type Locale } from '@/lib/docs'

interface Props {
  locale?: Locale
  page: DocPage
}

const { locale = defaultLocale, page } = Astro.props
const navGroups = getNavGroups(locale)
const persistKey = `docs-sidebar-${locale}`
---

<aside
  class="hidden min-w-0 bg-background md:sticky md:top-20 md:block md:h-[calc(100svh-5rem)] md:self-start md:overflow-y-auto"
  transition:persist={persistKey}>
  <nav
    aria-label="Documentation sections"
    class="flex gap-5 overflow-x-auto py-3 md:flex-col md:gap-6 md:py-10">
    {
      navGroups.map((group, groupIndex) => (
        <div class="shrink-0">
          {group.label && (
            <p
              class="mb-1.5 hidden h-6 items-center px-2 font-mono text-[0.6875rem] font-semibold tracking-[0.14em] text-muted-foreground/70 uppercase md:flex"
              id={`docs-nav-group-${groupIndex}`}>
              {group.label}
            </p>
          )}
          <ul
            aria-labelledby={
              group.label ? `docs-nav-group-${groupIndex}` : undefined
            }
            class:list={['flex gap-1 md:flex-col', group.label && 'md:ml-2']}>
            {group.items.map(item => (
              <li>
                <a
                  aria-current={item.id === page ? 'page' : undefined}
                  class="docs-nav-link inline-flex w-full shrink-0 items-center rounded-md px-2 py-1.5 text-sm whitespace-nowrap outline-none transition-colors focus-visible:ring-2 focus-visible:ring-ring"
                  data-doc-page={item.id}
                  href={item.href}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>

<script>
  const normalizedPath = (path: string) => {
    if (path === '/') return path

    return path.replace(/\/$/, '')
  }

  const syncCurrentPage = () => {
    const currentPath = normalizedPath(window.location.pathname)

    document.querySelectorAll<HTMLAnchorElement>('.docs-nav-link').forEach(link => {
      const linkPath = normalizedPath(new URL(link.href).pathname)
      const isErrorDetail =
        link.dataset.docPage === 'errors' && currentPath.startsWith(`${linkPath}/`)
      const isCurrent = linkPath === currentPath || isErrorDetail

      if (isCurrent) {
        link.setAttribute('aria-current', 'page')
        return
      }

      link.removeAttribute('aria-current')
    })
  }

  document.addEventListener('astro:page-load', syncCurrentPage)
  syncCurrentPage()
</script>
