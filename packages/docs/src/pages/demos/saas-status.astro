---
import TerminalDemo from '@/components/demos/terminal-demo.astro'
import Layout from '@/layouts/main.astro'

const title = 'Terminal demo'
const description = 'Run the fixed saas status func example in the browser.'
---

<Layout authors={['Witt']} description={description} title={title}>
  <main
    class="mx-auto flex min-h-screen w-full max-w-3xl flex-col justify-center px-4 py-16 sm:px-6">
    <div class="mb-8">
      <p class="mb-2 font-mono text-xs text-muted-foreground uppercase">
        Component preview
      </p>
      <h1 class="font-mono text-3xl font-bold tracking-tight text-foreground">
        Fixed func command
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-7 text-muted-foreground">
        This demo executes the registered <code
          class="rounded-sm bg-muted px-1.5 py-0.5 font-mono text-sm text-foreground"
          >saas status</code
        > example. It does not expose a shell or accept other commands.
      </p>
    </div>
    <TerminalDemo
      command="saas status"
      demo="saas-status"
      sourceUrl="/demos/saas-status.ts"
    />
  </main>
</Layout>
